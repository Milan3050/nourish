# ---- LLM (any OpenAI-compatible endpoint) -------------------------------------------------------
# Local development with Ollama (default). `make ollama-models` pulls qwen2.5:7b-instruct and
# nomic-embed-text and creates nip-qwen2.5:7b-32k: the same weights with a 32k context window.
# Ollama servers often default to 2-8k (OLLAMA_CONTEXT_LENGTH) and silently cut the start of long
# agent transcripts, which is where the system prompt and goal are.
NIP_LLM_BASE_URL=http://localhost:11434/v1
NIP_LLM_API_KEY=ollama
NIP_LLM_MODEL=nip-qwen2.5:7b-32k
# Typed output for router/judge: auto (json_schema for Ollama, function_calling for hosted APIs)
# NIP_LLM_STRUCTURED_METHOD=auto
# Optional: a smaller model for supervisor routing, a different model as eval judge
# NIP_LLM_ROUTER_MODEL=qwen2.5:3b-instruct
# NIP_LLM_JUDGE_MODEL=nip-llama3.1:8b-12k   # created by make ollama-models if llama3.1 is installed

# ---- Hosted model: comment out the three local lines above, uncomment ONE block, run `make check-llm`.
# Nothing else changes: embeddings and retrieval stay on local Ollama. Model names change over time;
# use one your key can access. Add its price to NIP_PRICING below to see real cost per run.
#
# OpenAI
# NIP_LLM_BASE_URL=https://api.openai.com/v1
# NIP_LLM_API_KEY=sk-...
# NIP_LLM_MODEL=gpt-4o-mini
# NIP_LLM_TEMPERATURE=            # only for reasoning models (o-series, gpt-5*) that reject temperature
#
# Anthropic (Claude, through its OpenAI-compatible endpoint)
# NIP_LLM_BASE_URL=https://api.anthropic.com/v1/
# NIP_LLM_API_KEY=sk-ant-...
# NIP_LLM_MODEL=claude-sonnet-5-5
# NIP_LLM_ROUTER_MODEL=claude-haiku-4-5-20251001   # optional: cheaper, faster routing
#
# Google Gemini
# NIP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# NIP_LLM_API_KEY=...
# NIP_LLM_MODEL=gemini-2.0-flash
#
# Groq
# NIP_LLM_BASE_URL=https://api.groq.com/openai/v1
# NIP_LLM_API_KEY=gsk_...
# NIP_LLM_MODEL=llama-3.3-70b-versatile

# ---- Embeddings / retrieval -----------------------------------------------------------------------
NIP_EMBEDDINGS_PROVIDER=ollama          # ollama | fastembed | hash (tests only)
NIP_EMBEDDINGS_MODEL=nomic-embed-text
NIP_EMBEDDINGS_DIM=768
NIP_EMBEDDINGS_BASE_URL=http://localhost:11434
NIP_RERANKER=none                       # none | fastembed (uv sync --extra local-embeddings)

# ---- Storage / tools ------------------------------------------------------------------------------
NIP_DATABASE_URL=postgresql://nip:nip@localhost:5432/nip
NIP_TOOL_TRANSPORT=mcp                  # mcp | inprocess
NIP_MCP_SERVER_URL=http://localhost:8765/mcp

# ---- Budgets -------------------------------------------------------------------------------------
# Local models are free but slow and need more attempts: generous budgets. For hosted models remove
# these lines (defaults: 120000 tokens, 16 planner steps, 12 supervisor steps, 120 s per call).
NIP_MAX_REQUEST_TOKENS=1000000
NIP_MAX_PLANNER_STEPS=24
NIP_MAX_SUPERVISOR_STEPS=18
NIP_LLM_TIMEOUT_S=300

# ---- Cost accounting ------------------------------------------------------------------------------
# USD per 1M tokens [input, output]. Local Ollama models are free. The reference model prices each run's
# tokens as if a hosted model had been used (an estimate; check the provider's current prices).
NIP_PRICING={"gpt-4o-mini": [0.15, 0.60]}
NIP_PRICING_REFERENCE_MODEL=gpt-4o-mini

# ---- Security / ops -------------------------------------------------------------------------------
NIP_ENV=dev
NIP_JWT_SECRET=change-me-in-any-shared-environment
NIP_LOG_LEVEL=INFO
NIP_LOG_JSON=false
NIP_OTEL_ENDPOINT=http://localhost:6006/v1/traces   # Arize Phoenix UI at http://localhost:6006
